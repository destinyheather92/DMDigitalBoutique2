# ---------------------------------------------------------------------------
# DM Digital Boutique — environment variables
# Copy to .env.local for local development, and add the same keys in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment
# Variables) for production. Never commit real values.
# ---------------------------------------------------------------------------

# The live site address. Used for canonical URLs, the sitemap, Open Graph
# tags and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dmdigitalboutique.com

# ---- Project inquiry form (REQUIRED for the form to deliver messages) -------
# Without these, the form shows a clear "please email me directly" error —
# it never pretends a message was sent.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address on a domain verified in Resend (dmdigitalboutique.com).
# This must stay on your domain: Resend cannot send "from" a Gmail address.
# Inquiries still arrive in your Gmail via CONTACT_TO_EMAIL below.
CONTACT_FROM_EMAIL="DM Digital Boutique <hello@dmdigitalboutique.com>"

# Where inquiries are delivered. Defaults to dhmills292@gmail.com (the email shown on the site).
CONTACT_TO_EMAIL=dhmills292@gmail.com

# "true" sends the visitor a short "I received your inquiry" email.
CONTACT_SEND_CONFIRMATION=false

# ---- Optional: Cloudflare Turnstile (extra spam protection) ---------------
# The form already uses a honeypot, a timing check and rate limiting.
# Set BOTH keys to add Turnstile's invisible/managed challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Optional: Google tools (not configured yet) ---------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Nothing loads until set.
# The Privacy page updates its analytics wording automatically when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification code (just the content value).
GOOGLE_SITE_VERIFICATION=
